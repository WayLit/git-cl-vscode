{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "labels": ["dependencies"],

  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",

  "schedule": ["before 6am on monday"],
  "separateMajorMinor": false,
  "packageRules": [
    {
      "description": "Batch every routine update, major included, into one PR",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ],

  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "major": {
    "automerge": true
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },

  "vulnerabilityAlerts": {
    "description": "Security fixes skip the weekly window, but batch together",
    "groupName": "security fixes",
    "groupSlug": "security",
    "schedule": [],
    "minimumReleaseAge": "1 day",
    "automerge": true,
    "labels": ["dependencies", "security"]
  }
}
